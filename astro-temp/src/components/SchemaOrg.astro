---
/**
 * SchemaOrg.astro
 * Gera JSON-LD automaticamente baseado nas props da página.
 *
 * Props:
 *   title          — título da página
 *   description    — descrição da página
 *   path           — caminho da URL (ex: "/", "/sobre/", "/consulta/")
 *   type           — tipo da página: "home" | "about" | "search" | "legal" | "form" | "blog" | "blogpost"
 *   faq?           — array de { pergunta, resposta } para FAQPage schema
 *   author?        — nome do autor (blogpost)
 *   datePublished? — data de publicação ISO (blogpost)
 *   category?      — categoria do post (blogpost)
 */

interface FaqItem {
  pergunta: string
  resposta: string
}

interface Props {
  title: string
  description: string
  path: string
  type: 'home' | 'about' | 'search' | 'legal' | 'form' | 'blog' | 'blogpost'
  faq?: FaqItem[]
  author?: string
  datePublished?: string
  category?: string
}

const { title, description, path, type, faq, author, datePublished, category } = Astro.props

const BASE_URL = 'https://pretensaosalarial.com.br'
const SITE_NAME = 'Pretensão Salarial'
const LOGO_URL = `${BASE_URL}/favicon.svg`
const url = `${BASE_URL}${path}`

// ── WebSite (todas as páginas) ──────────────────────────────────────────────
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: BASE_URL,
  description: 'Pesquisa colaborativa e anônima sobre salários no Brasil, que tem como objetivo ajudar profissionais de diversas áreas a definir sua pretensão salarial baseada em dados.',
  inLanguage: 'pt-BR'
}

// ── WebPage (todas as páginas exceto blogpost) ──────────────────────────────
const webpageTypeMap: Record<string, string> = {
  home: 'WebPage',
  about: 'AboutPage',
  search: 'WebPage',
  legal: 'WebPage',
  form: 'WebPage',
  blog: 'CollectionPage',
}

const webpageSchema = type !== 'blogpost' ? {
  '@context': 'https://schema.org',
  '@type': webpageTypeMap[type] ?? 'WebPage',
  name: `${title} — ${SITE_NAME}`,
  description,
  url,
  inLanguage: 'pt-BR',
  isPartOf: { '@id': BASE_URL },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: BASE_URL,
    logo: {
      '@type': 'ImageObject',
      url: LOGO_URL
    }
  }
} : null

// ── Organization (home e about) ─────────────────────────────────────────────
const organizationSchema = (type === 'home' || type === 'about') ? {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: BASE_URL,
  logo: {
    '@type': 'ImageObject',
    url: LOGO_URL
  },
  description: 'Plataforma independente de pesquisa salarial colaborativa e anônima para profissionais brasileiros.',
  foundingDate: '2025',
  areaServed: {
    '@type': 'Country',
    name: 'Brasil'
  }
} : null

// ── Dataset (consulta) ──────────────────────────────────────────────────────
const datasetSchema = type === 'search' ? {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Pesquisa Salarial Brasil — Pretensão Salarial',
  description: 'Base de dados colaborativa com salários reais de profissionais brasileiros, filtráveis por cargo, área, senioridade, regime, modelo de trabalho e região.',
  url: `${BASE_URL}/consulta/`,
  inLanguage: 'pt-BR',
  license: 'https://creativecommons.org/licenses/by-nc/4.0/',
  isAccessibleForFree: true,
  creator: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: BASE_URL
  },
  temporalCoverage: 'P36M',
  spatialCoverage: {
    '@type': 'Country',
    name: 'Brasil'
  },
  variableMeasured: [
    'Salário bruto mensal',
    'Cargo',
    'Área de atuação',
    'Senioridade',
    'Regime de contratação',
    'Modelo de trabalho',
    'Estado',
    'Cidade',
    'Porte da empresa',
    'Setor'
  ]
} : null

// ── Blog (home do blog e categorias) ────────────────────────────────────────
const blogSchema = type === 'blog' ? {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: path === '/blog/' ? `Blog — ${SITE_NAME}` : `${title} — Blog ${SITE_NAME}`,
  description,
  url,
  inLanguage: 'pt-BR',
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: BASE_URL,
    logo: {
      '@type': 'ImageObject',
      url: LOGO_URL
    }
  }
} : null

// ── BlogPosting (post individual) ───────────────────────────────────────────
const blogPostingSchema = type === 'blogpost' ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url,
  inLanguage: 'pt-BR',
  datePublished: datePublished ?? null,
  dateModified: datePublished ?? null,
  author: author ? {
    '@type': 'Person',
    name: author,
    url: `${BASE_URL}/blog/autor/${author.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-')}/`
  } : undefined,
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: BASE_URL,
    logo: {
      '@type': 'ImageObject',
      url: LOGO_URL
    }
  },
  isPartOf: {
    '@type': 'Blog',
    name: `Blog — ${SITE_NAME}`,
    url: `${BASE_URL}/blog/`
  },
  articleSection: category ?? undefined,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url
  }
} : null

// ── FAQPage (quando faq[] for passado) ─────────────────────────────────────
const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(item => ({
    '@type': 'Question',
    name: item.pergunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.resposta
    }
  }))
} : null

// ── BreadcrumbList (páginas internas) ──────────────────────────────────────
const breadcrumbItems: { '@type': string; position: number; name: string; item: string }[] = [
  { '@type': 'ListItem', position: 1, name: 'Início', item: BASE_URL }
]

if (type === 'blogpost') {
  breadcrumbItems.push({ '@type': 'ListItem', position: 2, name: 'Blog', item: `${BASE_URL}/blog/` })
  if (category) {
    breadcrumbItems.push({ '@type': 'ListItem', position: 3, name: category, item: `${BASE_URL}/blog/categoria/${category.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-')}/` })
    breadcrumbItems.push({ '@type': 'ListItem', position: 4, name: title, item: url })
  } else {
    breadcrumbItems.push({ '@type': 'ListItem', position: 3, name: title, item: url })
  }
} else if (type === 'blog' && path !== '/blog/') {
  breadcrumbItems.push({ '@type': 'ListItem', position: 2, name: 'Blog', item: `${BASE_URL}/blog/` })
  breadcrumbItems.push({ '@type': 'ListItem', position: 3, name: title, item: url })
} else if (path !== '/') {
  breadcrumbItems.push({ '@type': 'ListItem', position: 2, name: title, item: url })
}

const breadcrumbSchema = path !== '/' ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems
} : null

const schemas = [
  websiteSchema,
  webpageSchema,
  organizationSchema,
  datasetSchema,
  blogSchema,
  blogPostingSchema,
  faqSchema,
  breadcrumbSchema,
].filter(Boolean)
---

{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 0)} />
))}