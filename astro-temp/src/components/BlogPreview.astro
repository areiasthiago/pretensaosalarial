---
import { getCollection } from 'astro:content'
import { corCategoria } from '../data/categorias'

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric' })
}
---

<section class="blog-preview">
  <div class="container">
    <div class="blog-preview-header">
      <h2 class="blog-preview-title">Do blog</h2>
      <a href="/blog/" class="blog-preview-link">Ver todos os posts →</a>
    </div>

    <div class="blog-preview-grid">
      {posts.map(post => {
        const cor = corCategoria(post.data.category)
        return (
          <a href={`/blog/${post.id}/`} class="blog-preview-card">
            <span class="blog-preview-categoria" style={`background: ${cor.bg}; color: ${cor.text};`}>
              {post.data.category}
            </span>
            <h3 class="blog-preview-card-titulo">{post.data.title}</h3>
            <p class="blog-preview-card-summary">{post.data.summary}</p>
            <div class="blog-preview-card-meta">
              {post.data.author} · {formatDate(post.data.date)}
            </div>
          </a>
        )
      })}
    </div>
  </div>
</section>

<style>
  .blog-preview {
    padding: var(--space-12) 0;
  }

  .blog-preview-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-6);
  }

  .blog-preview-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    margin: 0;
    color: var(--color-text);
  }

  .blog-preview-link {
    font-size: var(--text-sm);
    color: var(--color-primary-500);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }

  .blog-preview-link:hover {
    text-decoration: underline;
  }

  .blog-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .blog-preview-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .blog-preview-card:hover {
    border-color: var(--color-primary-200);
    box-shadow: 0 2px 16px rgba(124, 58, 237, 0.08);
  }

  .blog-preview-categoria {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 3px var(--space-3);
    border-radius: var(--radius-full);
    align-self: flex-start;
  }

  .blog-preview-card-titulo {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    margin: 0;
    line-height: var(--leading-heading);
    color: var(--color-text);
  }

  .blog-preview-card-summary {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
    line-height: var(--leading-body);
    flex: 1;
  }

  .blog-preview-card-meta {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .blog-preview-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 1024px) and (min-width: 769px) {
    .blog-preview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>