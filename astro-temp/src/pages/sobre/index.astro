---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import TextSection from '../../components/TextSection.astro';
import InsightCards from '../../components/InsightCards.astro';
import NumberCards from '../../components/NumberCards.astro';
import CtaCard from '../../components/CtaCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import AdSlot from '../../components/AdSlot.astro';
import { faqSobre } from '../../data/faqs';

import '../../styles/pages/sobre.css';
---

<Layout
  title="Sobre o projeto — Pretensão Salarial"
  description="Entenda o que é o Pretensão Salarial, como funciona a pesquisa colaborativa de salários e por que a transparência salarial importa para todos."
  path="/sobre/"
  schemaType="about"
  faq={faqSobre}
>

  <!-- 1. Banner — branco -->
  <PageBanner
    tag="Sobre o projeto"
    title="Transparência salarial para quem trabalha"
    subtitle="Uma pesquisa colaborativa e anônima para ajudar profissionais brasileiros a entender quanto o mercado realmente paga."
    ctas={[
      { label: 'Cadastrar meu salário', href: '/cadastro/', variant: 'primary' },
      { label: 'Fazer uma consulta', href: '/consulta/', variant: 'secondary' },
    ]}
  >
    <svg slot="illustration" viewBox="0 0 400 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="90" cy="90" r="28" fill="#EDE9FE"/>
      <circle cx="90" cy="82" r="13" fill="#C4B5FD"/>
      <path d="M66 124c0-13 11-22 24-22s24 9 24 22" stroke="#C4B5FD" stroke-width="2.5" stroke-linecap="round" fill="none"/>
      <circle cx="200" cy="82" r="36" fill="#EDE9FE"/>
      <circle cx="200" cy="72" r="17" fill="#7C3AED" opacity="0.7"/>
      <path d="M172 122c0-16 13-27 28-27s28 11 28 27" stroke="#7C3AED" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.7"/>
      <circle cx="310" cy="90" r="28" fill="#CCFBF1"/>
      <circle cx="310" cy="82" r="13" fill="#14B8A6" opacity="0.6"/>
      <path d="M286 124c0-13 11-22 24-22s24 9 24 22" stroke="#14B8A6" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.6"/>
      <line x1="118" y1="100" x2="164" y2="104" stroke="#C4B5FD" stroke-width="1.5" stroke-dasharray="5 4"/>
      <line x1="236" y1="104" x2="282" y2="100" stroke="#14B8A6" stroke-width="1.5" stroke-dasharray="5 4" opacity="0.6"/>
      <rect x="152" y="144" width="96" height="48" rx="12" fill="#7C3AED"/>
      <polygon points="200,192 191,206 209,192" fill="#7C3AED"/>
      <text x="200" y="162" text-anchor="middle" dominant-baseline="middle" font-size="12" fill="white" font-family="system-ui" font-weight="600">Pretensão</text>
      <text x="200" y="176" text-anchor="middle" dominant-baseline="middle" font-size="12" fill="white" font-family="system-ui" font-weight="600">salarial</text>
      <rect x="52" y="148" width="66" height="32" rx="10" fill="#EDE9FE" stroke="#C4B5FD" stroke-width="1.5"/>
      <polygon points="85,180 78,192 92,180" fill="#EDE9FE" stroke="#C4B5FD" stroke-width="1.5"/>
      <text x="85" y="164" text-anchor="middle" dominant-baseline="middle" font-size="12" fill="#7C3AED" font-family="system-ui" font-weight="600">R$ 6k</text>
      <rect x="282" y="148" width="66" height="32" rx="10" fill="#CCFBF1" stroke="#14B8A6" stroke-width="1.5"/>
      <polygon points="315,180 308,192 322,180" fill="#CCFBF1" stroke="#14B8A6" stroke-width="1.5"/>
      <text x="315" y="164" text-anchor="middle" dominant-baseline="middle" font-size="12" fill="#0F766E" font-family="system-ui" font-weight="600">R$ 9k</text>
      <line x1="40" y1="232" x2="360" y2="232" stroke="#E5E3F5" stroke-width="1.5"/>
      <rect x="140" y="220" width="120" height="24" rx="12" fill="#14B8A6" opacity="0.15"/>
      <text x="200" y="232" text-anchor="middle" dominant-baseline="middle" font-size="11" fill="#0F766E" font-family="system-ui" font-weight="700">mediana R$ 7,5k</text>
    </svg>
  </PageBanner>

  <AdSlot id="ad-sobre-top" />

  <TextSection
    tag="Nossa missão"
    title="Acabar com o tabu do salário no Brasil"
    paragraphs={[
      'Quantas vezes você aceitou uma proposta sem saber se era justa? Ou ficou com aquela sensação de que seus colegas ganham mais — mas nunca teve como confirmar?',
      'O <strong>Pretensão Salarial</strong> existe para mudar isso. Somos uma plataforma independente, sem vínculo com empresas ou recrutadores. Nosso único objetivo é dar informação de qualidade para quem trabalha.',
      'Acreditamos que a transparência salarial é uma ferramenta de equidade. Quando as pessoas têm acesso a dados reais, as negociações ficam mais justas — para todo mundo.',
    ]}
  />

  <InsightCards
    title="Nossos princípios"
    cards={[
      { emoji: '🔒', titulo: 'Anonimato total', texto: 'Não pedimos nome ou CPF. O e-mail é convertido em hash criptográfico irreversível — nunca armazenamos o dado original, apenas o código gerado a partir dele.' },
      { emoji: '🏛️', titulo: 'Independência', texto: 'Não temos vínculo com empresas, RHs ou plataformas de recrutamento. Nenhum dado é vendido ou compartilhado com terceiros.' },
      { emoji: '👁️', titulo: 'Transparência', texto: 'Exibimos a metodologia, o tamanho da amostra e as limitações dos dados. Resultados com menos de 5 respostas não são exibidos.' },
      { emoji: '🤝', titulo: 'Acesso livre', texto: 'A consulta é gratuita e não exige cadastro. O projeto se sustenta com publicidade não intrusiva — nunca com paywall.' },
      { emoji: '🔁', titulo: 'Colaborativo', texto: 'A pesquisa melhora com cada contribuição. Ao participar, você beneficia a si mesmo e a quem vem depois.' },
      { emoji: '🇧🇷', titulo: 'Feito para o Brasil', texto: 'Pensado para a realidade do mercado brasileiro — CLT, PJ, regiões, setores e particularidades que ferramentas gringas ignoram.' },
    ]}
  />

  <AdSlot id="ad-sobre-middle" />

  <NumberCards
    title="Como funciona"
    cards={[
      { titulo: 'Você compartilha', texto: 'Cadastre seu salário atual de forma anônima. Pedimos apenas dados profissionais — nenhuma informação pessoal identificável é armazenada.' },
      { titulo: 'A base cresce', texto: 'Cada contribuição torna os dados mais representativos. Quanto mais pessoas participam, mais precisa fica a pesquisa para todo mundo.' },
      { titulo: 'Todos consultam', texto: 'Filtre por cargo, área, senioridade, região e mais. Veja medianas, faixas e distribuição salarial — de graça, sem criar conta.' },
    ]}
  />

  <InsightCards
    title="Por que a transparência salarial importa"
    cards={[
      { emoji: '⚖️', titulo: 'Reduz desigualdade', texto: 'Quando as pessoas sabem o que o mercado paga, fica mais difícil oferecer salários injustos para grupos historicamente discriminados.' },
      { emoji: '💬', titulo: 'Fortalece negociações', texto: 'Chegar numa negociação com dados reais muda completamente o poder de barganha — especialmente para quem nunca teve essa informação.' },
      { emoji: '🧭', titulo: 'Orienta carreiras', texto: 'Saber o que o mercado paga em diferentes senioridades e áreas ajuda a tomar decisões de carreira com mais clareza e menos achismo.' },
      { emoji: '📊', titulo: 'Gera dados públicos', texto: 'No Brasil, pesquisas salariais confiáveis e atualizadas são escassas e caras. Colaboração aberta é a forma de mudar isso.' },
      { emoji: '🌎', titulo: 'Funciona em outros países', texto: 'Iniciativas similares como Glassdoor e Levels.fyi reduziram a assimetria de informação em mercados inteiros.' },
      { emoji: '📈', titulo: 'Quanto mais, melhor', texto: 'A qualidade dos dados cresce com cada resposta. Uma base maior significa faixas mais precisas e filtros mais granulares.' },
    ]}
  />

  <TextSection
    tag="Metodologia"
    title="Como os dados são coletados e calculados"
    paragraphs={[
      'Os dados são coletados por meio de formulário voluntário e anônimo. Não realizamos verificação de vínculo empregatício — confiamos na boa-fé dos participantes e usamos proteções técnicas (honeypot, reCAPTCHA, rate limit por dispositivo) para reduzir entradas fraudulentas.',
      'Para exibir resultados de uma combinação de filtros, exigimos no mínimo <strong>5 respostas</strong>. Isso protege a privacidade dos participantes e evita que um único dado distorça a percepção da faixa.',
      'Utilizamos a <strong>mediana</strong> como referência principal — ela é menos sensível a valores extremos do que a média, refletindo melhor o salário "do meio" do mercado. Exibimos também o intervalo entre os percentis 25 e 75, a faixa onde se concentra metade dos respondentes.',
      'Os dados têm janela de <strong>36 meses</strong>: apenas registros dos últimos 3 anos são considerados nas consultas, mantendo a base relevante e atualizada.',
    ]}
  />

  <CtaCard
    title="Faça parte da pesquisa"
    text="Seu salário, anonimizado, ajuda milhares de profissionais a negociar melhor. Leva menos de 3 minutos."
    label="Cadastrar meu salário"
    href="/cadastro/"
  />

  <div class="section-alt">
    <FaqSection title="Dúvidas sobre o projeto" items={faqSobre} />
  </div>

</Layout>