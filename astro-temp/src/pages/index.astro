---
import Layout from '../layouts/Layout.astro'
import '../styles/pages/home.css'
import AdSlot from '../components/AdSlot.astro'
import PageBanner from '../components/PageBanner.astro'
import InsightCards from '../components/InsightCards.astro'
import NumberCards from '../components/NumberCards.astro'
import CtaCard from '../components/CtaCard.astro'
import FaqSection from '../components/FaqSection.astro'
import { faqHome } from '../data/faqs'
---
<Layout
  title="Descubra quanto vale o seu trabalho"
  description="Salários reais de profissionais brasileiros. Consulte faixas salariais por cargo, área, senioridade e região para negociar com confiança — gratuito e anônimo."
  path="/"
  schemaType="home"
  faq={faqHome}
>
  <!-- HERO -->
  <PageBanner
    tag="100% gratuito e anônimo"
    title="Saiba a resposta exata para sua pretensão salarial"
    subtitle="Dados reais compartilhados por profissionais como você. Consulte faixas salariais por cargo, área, senioridade e região."
    ctas={[
      { label: 'Cadastrar meu salário', href: '/cadastro/', variant: 'primary' },
      { label: 'Consultar salários', href: '/consulta/', variant: 'secondary' }
    ]}
  >
    <svg slot="illustration" viewBox="0 0 400 280" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="80" y="30" width="260" height="220" rx="12" fill="none" stroke="#DDD6FE" stroke-width="1.5"/>
      <rect x="60" y="20" width="260" height="220" rx="12" fill="#EDE9FE" stroke="#C4B5FD" stroke-width="1.5"/>
      <rect x="60" y="20" width="260" height="52" rx="12" fill="#7C3AED"/>
      <rect x="60" y="60" width="260" height="12" fill="#7C3AED"/>
      <text x="190" y="50" text-anchor="middle" font-family="system-ui" font-size="12" font-weight="600" fill="white">Qual sua pretensão salarial?</text>
      <rect x="88" y="88" width="204" height="24" rx="6" fill="white" stroke="#C4B5FD" stroke-width="1"/>
      <rect x="96" y="96" width="80" height="8" rx="4" fill="#DDD6FE"/>
      <rect x="88" y="124" width="96" height="24" rx="6" fill="white" stroke="#C4B5FD" stroke-width="1"/>
      <rect x="96" y="132" width="50" height="8" rx="4" fill="#DDD6FE"/>
      <rect x="196" y="124" width="96" height="24" rx="6" fill="white" stroke="#C4B5FD" stroke-width="1"/>
      <rect x="204" y="132" width="60" height="8" rx="4" fill="#DDD6FE"/>
      <rect x="88" y="160" width="204" height="24" rx="6" fill="white" stroke="#C4B5FD" stroke-width="1"/>
      <rect x="96" y="168" width="90" height="8" rx="4" fill="#DDD6FE"/>
      <rect x="88" y="200" width="204" height="28" rx="14" fill="#14B8A6"/>
      <text x="190" y="219" text-anchor="middle" font-family="system-ui" font-size="14" fill="white">E agora? 😰</text>
    </svg>
  </PageBanner>

  <!-- PUBLICIDADE -->
  <AdSlot id="ad-top" />

  <!-- NUMBER CARDS -->
  <NumberCards
    title="Como funciona"
    cards={[
      { titulo: 'Compartilhe seu salário', texto: 'Preencha um formulário rápido. Seu email é usado apenas para identificar seu cadastro e nunca é armazenado diretamente.' },
      { titulo: 'Dados reais se acumulam', texto: 'Cada contribuição torna a pesquisa mais precisa para todos os profissionais brasileiros.' },
      { titulo: 'Consulte e negocie melhor', texto: 'Use os dados para embasar sua pretensão salarial ou pleitear um aumento com confiança.' }
    ]}
  />

  <!-- CTA -->
  <CtaCard
    title="Contribua com a pesquisa"
    text="Leva menos de 3 minutos. Seus dados são anônimos e ajudam milhares de profissionais."
  />

  <!-- PUBLICIDADE -->
  <AdSlot id="ad-middle" />

  <!-- INSIGHTS CARDS -->
  <InsightCards
    title="Por que compartilhar seu salário?"
    cards={[
      { emoji: '💡', titulo: 'Conheça seu valor', texto: 'Profissionais que pesquisam o mercado antes de negociar chegam à conversa com evidências — não achismos.' },
      { emoji: '🔒', titulo: '100% anônimo', texto: 'Seu email é convertido em um código criptográfico irreversível, usado apenas para permitir que você faça atualizações.' },
      { emoji: '⏱️', titulo: 'Menos de 3 minutos', texto: 'Formulário rápido, direto ao ponto. Sem burocracia, sem perguntas desnecessárias.' },
      { emoji: '🤝', titulo: 'Ajude a categoria', texto: 'Cada cadastro fortalece a base de dados e dá mais poder de negociação para todos os profissionais brasileiros.' },
      { emoji: '📅', titulo: 'Dados sempre frescos', texto: 'Exibimos apenas dados dos últimos 36 meses, garantindo que as informações reflitam o mercado atual.' },
      { emoji: '🎯', titulo: 'Gratuito e sem cadastro', texto: 'Sem planos, sem assinatura, sem conta obrigatória. Consulte e contribua à vontade.' }
    ]}
  />

  <!-- PUBLICIDADE -->
  <AdSlot id="ad-bottom" />

  <!-- FAQ -->
  <FaqSection items={faqHome} />

</Layout>