---
import Layout from '../../../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { categorias, slugCategoria, corCategoria } from '../../../../data/categorias'
import BlogFiltros from '../../../../components/BlogFiltros.astro'
import BlogHeader from '../../../../components/BlogHeader.astro'
import AdSlot from '../../../../components/AdSlot.astro'
import '../../../../styles/main.css'
import '../../../../styles/pages/blog.css'

export async function getStaticPaths({ paginate }) {
  const todos = await getCollection('blog')

  return categorias.flatMap(cat => {
    const posts = todos
      .filter(p => p.data.category === cat.label)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

    return paginate(posts, {
      params: { categoria: slugCategoria(cat.label) },
      props: {
        categoriaLabel: cat.label,
        totalPostsCategoria: posts.length,
      },
      pageSize: 12,
    })
  })
}

const { page, categoriaLabel, totalPostsCategoria } = Astro.props
const { categoria } = Astro.params

const todos = await getCollection('blog')
const recentes = todos
  .filter(p => p.data.category !== categoriaLabel)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric' })
}

const cor = corCategoria(categoriaLabel)
const totalPages = page.lastPage
const currentPage = page.currentPage

function getPageNumbers(current: number, total: number): (number | '...')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)
  const pages: (number | '...')[] = [1]
  if (current > 3) pages.push('...')
  const start = Math.max(2, current - 1)
  const end = Math.min(total - 1, current + 1)
  for (let i = start; i <= end; i++) pages.push(i)
  if (current < total - 2) pages.push('...')
  pages.push(total)
  return pages
}

const pageNumbers = getPageNumbers(currentPage, totalPages)
const baseHref = `/blog/categoria/${categoria}/`

function pageHref(n: number) {
  return n === 1 ? baseHref : `${baseHref}${n}/`
}

const pageTitle = currentPage === 1
  ? categoriaLabel
  : `${categoriaLabel} — Página ${currentPage}`

function chunkPosts<T>(arr: T[], size: number): T[][] {
  const chunks: T[][] = []
  for (let i = 0; i < arr.length; i += size) {
    chunks.push(arr.slice(i, i + size))
  }
  return chunks
}

const postChunks = chunkPosts(page.data, 6)
---

<Layout
  title={pageTitle}
  description={`Artigos sobre ${categoriaLabel.toLowerCase()} no Brasil.`}
  path={baseHref}
  schemaType="blog"
>
  <BlogHeader
    titulo={categoriaLabel}
    backHref="/blog/"
    badge={{
      label: `${totalPostsCategoria} ${totalPostsCategoria === 1 ? 'post' : 'posts'}`,
      bg: cor.bg,
      text: cor.text,
    }}
  />

  <BlogFiltros categoriaAtiva={categoriaLabel} />

  <section class="blog-lista">
    <div class="container">
      {page.data.length > 0 ? (
        <>
          <AdSlot id="ad-cat-top" />

          {postChunks.map((chunk, chunkIndex) => (
            <>
              <div class="blog-grid">
                {chunk.map(post => {
                  const c = corCategoria(post.data.category)
                  return (
                    <a href={`/blog/${post.id}/`} class="blog-card">
                      <span class="blog-card-categoria" style={`background: ${c.bg}; color: ${c.text};`}>
                        {post.data.category}
                      </span>
                      <h2 class="blog-card-titulo">{post.data.title}</h2>
                      <p class="blog-card-descricao">{post.data.summary}</p>
                      <div class="blog-card-meta">
                        {post.data.author} · {formatDate(post.data.date)}
                      </div>
                    </a>
                  )
                })}
              </div>

              {chunkIndex < postChunks.length - 1 && (
                <AdSlot id={`ad-cat-${chunkIndex}`} />
              )}
            </>
          ))}

          <AdSlot id="ad-cat-bottom" />

          {totalPages > 1 && (
            <nav class="blog-paginacao" aria-label="Paginação do blog">
              {page.url.prev && (
                <a href={page.url.prev} class="blog-paginacao-btn" aria-label="Página anterior">
                  ←
                </a>
              )}

              {pageNumbers.map(n =>
                n === '...'
                  ? <span class="blog-paginacao-reticencias">…</span>
                  : <a
                      href={pageHref(n)}
                      class={`blog-paginacao-num${n === currentPage ? ' ativo' : ''}`}
                      aria-label={`Página ${n}`}
                      aria-current={n === currentPage ? 'page' : undefined}
                    >
                      {n}
                    </a>
              )}

              {page.url.next && (
                <a href={page.url.next} class="blog-paginacao-btn" aria-label="Próxima página">
                  →
                </a>
              )}
            </nav>
          )}
        </>
      ) : (
        <div class="blog-vazio">
          <p class="blog-vazio-texto">Nenhum post nessa categoria ainda.</p>
          <p class="blog-vazio-sub">Confira os posts mais recentes do blog:</p>
          <div class="blog-grid">
            {recentes.map(post => {
              const c = corCategoria(post.data.category)
              return (
                <a href={`/blog/${post.id}/`} class="blog-card">
                  <span class="blog-card-categoria" style={`background: ${c.bg}; color: ${c.text};`}>
                    {post.data.category}
                  </span>
                  <h2 class="blog-card-titulo">{post.data.title}</h2>
                  <p class="blog-card-descricao">{post.data.description}</p>
                  <div class="blog-card-meta">
                    {post.data.author} · {formatDate(post.data.date)}
                  </div>
                </a>
              )
            })}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-paginacao {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-12);
    flex-wrap: wrap;
  }

  .blog-paginacao-num,
  .blog-paginacao-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .blog-paginacao-num:hover,
  .blog-paginacao-btn:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .blog-paginacao-num.ativo {
    background: var(--color-primary-500);
    color: #fff;
    pointer-events: none;
  }

  .blog-paginacao-reticencias {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
<style is:global>
  #ad-cat-top {
    margin-bottom: var(--space-8);
  }

  [id^="ad-cat-"]:not(#ad-cat-top):not(#ad-cat-bottom) {
    margin-block: var(--space-8);
  }

  #ad-cat-bottom {
    margin-top: var(--space-8);
  }
</style>