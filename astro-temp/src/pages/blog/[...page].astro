---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { categorias, slugCategoria, corCategoria } from '../../data/categorias'
import BlogFiltros from '../../components/BlogFiltros.astro'
import BlogHeader from '../../components/BlogHeader.astro'
import '../../styles/main.css'
import '../../styles/pages/blog.css'

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  )
  return paginate(posts, { pageSize: 12 })
}

const { page } = Astro.props

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric' })
}

// Gera o array de páginas para a navegação numerada
const totalPages = page.lastPage
const currentPage = page.currentPage

// Lógica para mostrar no máximo 5 números + reticências
function getPageNumbers(current: number, total: number): (number | '...')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)

  const pages: (number | '...')[] = [1]

  if (current > 3) pages.push('...')

  const start = Math.max(2, current - 1)
  const end = Math.min(total - 1, current + 1)

  for (let i = start; i <= end; i++) pages.push(i)

  if (current < total - 2) pages.push('...')

  pages.push(total)

  return pages
}

const pageNumbers = getPageNumbers(currentPage, totalPages)

function pageHref(n: number) {
  return n === 1 ? '/blog/' : `/blog/${n}/`
}
---

<Layout
  title={currentPage === 1 ? 'Blog' : `Blog — Página ${currentPage}`}
  description="Artigos sobre salários, negociação, mercado de trabalho e carreira no Brasil."
  path="/blog/"
  schemaType="blog"
  noindex
>
  <BlogHeader
    titulo="Blog"
    subtitulo="Tudo sobre salários, negociação e mercado de trabalho no Brasil."
  />

  <BlogFiltros />

  <section class="blog-lista">
    <div class="container">
      <div class="blog-grid">
        {page.data.map(post => {
          const cor = corCategoria(post.data.category)
          return (
            <a href={`/blog/${post.id}/`} class="blog-card">
              <span
                class="blog-card-categoria"
                style={`background: ${cor.bg}; color: ${cor.text};`}
              >
                {post.data.category}
              </span>
              <h2 class="blog-card-titulo">{post.data.title}</h2>
              <p class="blog-card-descricao">{post.data.description}</p>
              <div class="blog-card-meta">
                {post.data.author} · {formatDate(post.data.date)}
              </div>
            </a>
          )
        })}
      </div>

      {totalPages > 1 && (
        <nav class="blog-paginacao" aria-label="Paginação do blog">
          {page.url.prev && (
            <a href={page.url.prev} class="blog-paginacao-btn" aria-label="Página anterior">
              ←
            </a>
          )}

          {pageNumbers.map(n =>
            n === '...'
              ? <span class="blog-paginacao-reticencias">…</span>
              : <a
                  href={pageHref(n)}
                  class={`blog-paginacao-num${n === currentPage ? ' ativo' : ''}`}
                  aria-label={`Página ${n}`}
                  aria-current={n === currentPage ? 'page' : undefined}
                >
                  {n}
                </a>
          )}

          {page.url.next && (
            <a href={page.url.next} class="blog-paginacao-btn" aria-label="Próxima página">
              →
            </a>
          )}
        </nav>
      )}
    </div>
  </section>
</Layout>

<style>
  .blog-paginacao {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-12);
    flex-wrap: wrap;
  }

  .blog-paginacao-num,
  .blog-paginacao-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .blog-paginacao-num:hover,
  .blog-paginacao-btn:hover {
    background: var(--color-surface);
    color: var(--color-text-primary);
  }

  .blog-paginacao-num.ativo {
    background: var(--color-primary-500);
    color: #fff;
    pointer-events: none;
  }

  .blog-paginacao-reticencias {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }
</style>