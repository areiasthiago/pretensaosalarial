---
import '@fontsource-variable/dm-sans/index.css'
import '../styles/main.css'
import AdSlot from '../components/AdSlot.astro'
import SchemaOrg from '../components/SchemaOrg.astro'
import pkg from '../../package.json'

interface FaqItem {
  pergunta: string
  resposta: string
}

interface Props {
  title: string
  description: string
  path?: string
  schemaType?: 'home' | 'about' | 'search' | 'legal' | 'form'
  faq?: FaqItem[]
}

const {
  title,
  description,
  path = '/',
  schemaType = 'home',
  faq
} = Astro.props
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title} — Pretensão Salarial</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <SchemaOrg
    title={title}
    description={description}
    path={path}
    type={schemaType}
    faq={faq}
  />
  <slot name="head" />
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-WFBX4W8C');</script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WFBX4W8C"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <a href="#main-content" class="skip-link">Pular para o conteúdo</a>
  <nav class="navbar">
    <div class="container">
      <a href="/" class="navbar-brand">
        <img src="/favicon.svg" alt="" width="24" height="24" style="display:inline-block; vertical-align: middle; margin-right: 8px; position: relative; top: -1px;">
        pretensão salarial <span class="version-tag">beta v{pkg.version}</span>
      </a>
      <div class="navbar-links">
        <a href="/sobre/">Sobre</a>
        <a href="/consulta/">Consultar salários</a>
        <a href="/cadastro/" class="btn btn-primary btn-sm">Cadastrar meu salário</a>
      </div>
      <button class="navbar-hamburger" id="hamburger" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div class="navbar-mobile" id="navbar-mobile">
      <a href="/sobre/">Sobre</a>
      <a href="/consulta/">Consultar salários</a>
      <a href="/cadastro/" class="btn btn-primary">Cadastrar meu salário</a>
      <AdSlot id="ad-hamburger" variant="hamburger" />
    </div>
  </nav>

  <script is:inline>
  document.getElementById('hamburger').addEventListener('click', () => {
    document.getElementById('navbar-mobile').classList.toggle('open')
    document.getElementById('hamburger').classList.toggle('open')
  })
  </script>

  <main id="main-content">
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <p>© 2026 Pretensão Salarial · <a href="/privacidade/">Privacidade</a> · <a href="/termos/">Termos de uso</a> · <a href="/sobre/">Sobre</a></p>
    </div>
  </footer>

</body>
</html>